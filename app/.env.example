# Dev Drill — frontend env (Vite). Copy to .env for local dev and set the same
# values in the Vercel project settings. Everything VITE_* is PUBLIC (inlined
# into the bundle) — fine for Auth0 SPA config + the API URL, never for secrets.
#
# Leave these UNSET to keep the app fully anonymous/local (today's behavior):
# the Auth0 provider and login button only activate once DOMAIN + CLIENT_ID exist.

# Auth0 SPA — the app's own Auth0 tenant. The gateway authorizer is keyed on the
# tenant (issuer) + this audience (an API defined in that tenant).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
VITE_AUTH0_AUDIENCE=https://entorno-biai

# Shared entorno-biai HTTP API; use /dev locally, /prod in production.
VITE_API_URL=https://m02lp78cnl.execute-api.us-east-1.amazonaws.com/dev

# Optional: load question banks from the cards API instead of bundled JSON.
# Leave unset/false to keep using the bundled banks (no network for content).
VITE_CARDS_FROM_API=false
